# Always fetch the latest page, settings and offline worker, so edits show up right away
<FilesMatch "(\.html|sw\.js|manifest\.webmanifest|\.js|\.css)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
# Fonts and icons rarely change: cache them for a year
<FilesMatch "\.(woff2|png|svg)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
AddType application/manifest+json .webmanifest

# Serve text as UTF-8 (fixes symbols like · and – showing as Â·)
AddDefaultCharset UTF-8
# Keep project notes private: only the invite itself is public
<FilesMatch "\.(md|txt)$|^\.git">
  Require all denied
</FilesMatch>

