# Always fetch the latest page, settings and offline worker, so edits show up right away
<FilesMatch "(index\.html|sw\.js|manifest\.webmanifest|config\.js)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
# Fonts and icons rarely change: cache them for a year
<FilesMatch "\.(woff2|png|svg|jpg)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
AddType application/manifest+json .webmanifest
